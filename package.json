{
  "name": "tabtether",
  "version": "0.1.1",
  "private": true,
  "description": "Local-first tethered tabs with optional cloud database and LAN sync",
  "type": "module",
  "scripts": {
    "dev": "wxt --host 0.0.0.0 --port 5555",
    "dev:firefox": "wxt -b firefox --host 0.0.0.0 --port 5555",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:firefox-android": "wxt build -b firefox-android --mv2",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "zip:firefox-android": "wxt zip -b firefox-android --mv2",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "bun run build && playwright test -c e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test -c e2e/playwright.config.ts --ui",
    "screenshots": "bun run build && bun run scripts/capture-store-screenshots.ts",
    "check": "oxlint && oxfmt --check"
  },
  "dependencies": {
    "@libsql/client": "^0.17.0",
    "material-shadcn": "^0.0.1-alpha.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "fake-indexeddb": "^6.2.4",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "typescript": "^6.0.3",
    "vitest": "4.1.10",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  },
  "overrides": {
    "vitest": "4.1.10"
  },
  "packageManager": "bun@1.3.6"
}
