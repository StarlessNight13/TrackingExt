{
  "name": "trackingext-extension",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-browser tracked tabs for TrackingExt",
  "type": "module",
  "scripts": {
    "dev": "wxt --host 0.0.0.0 --port 5555",
    "dev:firefox": "wxt -b firefox --host 0.0.0.0 --port 5555",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:firefox-android": "wxt build -b firefox-android --mv2",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "zip:firefox-android": "wxt zip -b firefox-android --mv2",
    "compile": "tsc --noEmit",
    "check-types": "tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@trackingext/api": "workspace:*",
    "@trackingext/env": "workspace:*",
    "@orpc/client": "catalog:",
    "material-shadcn": "^0.0.1-alpha.2",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@wxt-dev/module-react": "^1.1.5",
    "typescript": "catalog:",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  }
}
